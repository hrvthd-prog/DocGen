# Adatbázis és konfiguráció – személyes adat, soha nem kerül verziókezelésbe
data/
*.json.bak

# Dokumentumsablonok és generált iratok
Sablonok/
Kimenet/
Kész fájlok/
*.docx
*.docm
*.pdf

# Táblázatok
*.xlsx
*.xlsm
*.xlsb
*.xls
*.csv

# Naplók
logs/
*.log

# Tesztanyag – KIVÉTEL a fenti kizárások alól.
# Kitalált emberekkel dolgozik, valós személyes adat nincs benne. Enélkül a
# tesztek friss klónban nem futnak le, mert a fixture-ök hiányoznak – ezt
# lemértem, három teszt bukott el ENOENT-tel.
!test/fixtures/
!test/fixtures/**

# Kész, kitölthető PDF-sablonok (üres hatósági nyomtatvány + mezők, adat nélkül) —
# a repóval jutnak el a használat helyére; onnan kell a sablonmappába másolni.
!pdf-sablonok/
!pdf-sablonok/*.pdf

# Szerkesztő / ágens metaadat
.claude/
.cursor/
.vscode/

